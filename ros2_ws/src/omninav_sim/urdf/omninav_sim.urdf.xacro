<?xml version="1.0"?>
<!--
  OmniNav mecanum-wheel robot simulation model (verified on Gazebo Classic 11 / ROS2 Humble; the Jazzy side still uses the USB serial port and does not depend on this file)

  Notes:
  1. This file is a "primitive geometry approximation": dimensions come from CAD measurements (see below); collisions use box/cylinder,
     and SolidWorks meshes are not used directly (the full-robot mesh is 197k faces per wheel and would stall Gazebo).
  2. Dimension sources (2026-11-25 SolidWorks MCP measurements + inference):
     - Mecanum wheel: Ø80.37 x width 41.00 mm -> wheel_r=0.0400, wheel_w=0.0410
     - Motor mount spacing between the two groups: 203 mm / 210 mm -> wheelbase/track tentatively 0.200 / 0.210 (TODO re-measure)
     - Main chassis plate: 230 x 3 x 304.88 mm (including side plates); body bounding box taken as 230 x 180 x 90 mm
     - Total assembly mass is invalid at the default density 1000 kg/m3; mass/inertia are engineering estimates (TODO replace after weighing)
  3. Drive: libgazebo_ros_planar_move.so (omnidirectional, takes /cmd_vel directly, publishes /odom and TF).
     Therefore do not start stm32_bridge or fake_stm32.py at the same time in simulation, or /odom and TF will conflict.
  4. Lidar: libgazebo_ros_ray_sensor.so, 360 rays at 10 Hz, range 0.12-8 m, output /scan.
-->
<robot name="omninav_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Odom ownership switch. Default "true" = let the Gazebo planar_move plugin publish /odom + TF odom->base_link
       (quick smoke test). Set both to "false" when stm32_bridge owns /odom + TF, otherwise two publishers fight. -->
  <xacro:arg name="publish_odom" default="true"/>
  <xacro:arg name="publish_odom_tf" default="true"/>

  <!-- ==================== Tunable parameters (TODO: replace with real measurements) ==================== -->
  <xacro:property name="wheelbase" value="0.200"/>
  <xacro:property name="track"     value="0.210"/>
  <xacro:property name="wheel_r"   value="0.0400"/>
  <xacro:property name="wheel_w"   value="0.0410"/>
  <xacro:property name="base_l"    value="0.230"/>
  <xacro:property name="base_w"    value="0.180"/>
  <xacro:property name="base_h"    value="0.090"/>
  <xacro:property name="base_z"    value="0.075"/>   <!-- height of base_link above the ground -->
  <xacro:property name="m_base"    value="2.2"/>     <!-- kg, estimated -->
  <xacro:property name="m_wheel"   value="0.15"/>    <!-- kg, estimated -->
  <xacro:property name="m_batt"    value="0.55"/>
  <xacro:property name="m_pi"      value="0.10"/>
  <xacro:property name="m_stm32"   value="0.06"/>
  <xacro:property name="m_lidar"   value="0.12"/>

  <!-- ==================== Inertia macros ==================== -->
  <xacro:macro name="inertial_box" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x+z*z)/12}" iyz="0.0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cyl" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12}" ixy="0.0" ixz="0.0"
               iyy="${m*(3*r*r+l*l)/12}" iyz="0.0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== Chassis base_link ==================== -->
  <link name="base_link">
    <xacro:inertial_box m="${m_base}" x="${base_l}" y="${base_w}" z="${base_h}"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_l} ${base_w} ${base_h}"/></geometry>
      <material name="omninav_grey"><color rgba="0.25 0.27 0.30 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${base_l} ${base_w} ${base_h}"/></geometry>
    </collision>
  </link>

  <!-- ==================== Mecanum wheels (4, fixed joints; planar_move does not need the wheels to spin) ==================== -->
  <xacro:macro name="wheel" params="name x y">
    <link name="wheel_${name}">
      <xacro:inertial_cyl m="${m_wheel}" r="${wheel_r}" l="${wheel_w}"/>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="wheel_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
    </link>
    <joint name="wheel_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="wheel_${name}"/>
      <origin xyz="${x} ${y} ${wheel_r - base_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="fl" x="${ wheelbase/2}" y="${ track/2}"/>
  <xacro:wheel name="fr" x="${ wheelbase/2}" y="${-track/2}"/>
  <xacro:wheel name="rl" x="${-wheelbase/2}" y="${ track/2}"/>
  <xacro:wheel name="rr" x="${-wheelbase/2}" y="${-track/2}"/>

  <!-- ==================== Body parts (visual only, not relevant to the dynamics) ==================== -->
  <!-- Battery box: located at the rear top of the chassis in CAD -->
  <link name="battery_link">
    <xacro:inertial_box m="${m_batt}" x="0.11" y="0.075" z="0.055"/>
    <visual>
      <geometry><box size="0.11 0.075 0.055"/></geometry>
      <material name="batt_blue"><color rgba="0.10 0.25 0.55 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.11 0.075 0.055"/></geometry></collision>
  </link>
  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/><child link="battery_link"/>
    <origin xyz="-0.045 0 ${base_h/2 + 0.0275}" rpy="0 0 0"/>
  </joint>

  <!-- Raspberry Pi 5 -->
  <link name="pi_link">
    <xacro:inertial_box m="${m_pi}" x="0.09" y="0.06" z="0.03"/>
    <visual>
      <geometry><box size="0.09 0.06 0.03"/></geometry>
      <material name="pi_green"><color rgba="0.05 0.35 0.15 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.09 0.06 0.03"/></geometry></collision>
  </link>
  <joint name="pi_joint" type="fixed">
    <parent link="base_link"/><child link="pi_link"/>
    <origin xyz="0.055 0.030 ${base_h/2 + 0.015}" rpy="0 0 0"/>
  </joint>

  <!-- STM32F103ZET6 main board -->
  <link name="stm32_link">
    <xacro:inertial_box m="${m_stm32}" x="0.10" y="0.06" z="0.02"/>
    <visual>
      <geometry><box size="0.10 0.06 0.02"/></geometry>
      <material name="stm32_dark"><color rgba="0.05 0.10 0.20 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.10 0.06 0.02"/></geometry></collision>
  </link>
  <joint name="stm32_joint" type="fixed">
    <parent link="base_link"/><child link="stm32_link"/>
    <origin xyz="0.055 -0.030 ${base_h/2 + 0.010}" rpy="0 0 0"/>
  </joint>

  <!-- 2D lidar (position/height are placeholders, TODO confirm on the real robot; in practice it is either front-mounted on the ESP32-S3 or roof-mounted, depending on final assembly) -->
  <link name="lidar_link">
    <xacro:inertial_cyl m="${m_lidar}" r="0.030" l="0.050"/>
    <visual>
      <geometry><cylinder radius="0.030" length="0.050"/></geometry>
      <material name="lidar_silver"><color rgba="0.65 0.65 0.68 1.0"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.030" length="0.050"/></geometry></collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0 0 ${base_h/2 + 0.025}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Gazebo: materials and friction ==================== -->
  <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="wheel_fl"><material>Gazebo/FlatBlack</material><mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>1.0</kd></gazebo>
  <gazebo reference="wheel_fr"><material>Gazebo/FlatBlack</material><mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>1.0</kd></gazebo>
  <gazebo reference="wheel_rl"><material>Gazebo/FlatBlack</material><mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>1.0</kd></gazebo>
  <gazebo reference="wheel_rr"><material>Gazebo/FlatBlack</material><mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000.0</kp><kd>1.0</kd></gazebo>
  <gazebo reference="battery_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="pi_link"><material>Gazebo/Green</material></gazebo>
  <gazebo reference="stm32_link"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="lidar_link"><material>Gazebo/Grey</material></gazebo>

  <!-- ==================== Gazebo: omnidirectional drive plugin (/cmd_vel -> model motion + /odom + TF) ==================== -->
  <gazebo>
    <plugin name="omninav_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <update_rate>50.0</update_rate>
      <publish_rate>50.0</publish_rate>
      <publish_odom>$(arg publish_odom)</publish_odom>
      <publish_odom_tf>$(arg publish_odom_tf)</publish_odom_tf>
    </plugin>
  </gazebo>

  <!-- ==================== Gazebo: 2D lidar sensor -> /scan ==================== -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="omninav_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="omninav_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
