<?xml version="1.0" ?>
<!--
  OmniNav simulation world: an 8 m x 6 m warehouse site (perimeter walls + two shelves/pillars + two loose boxes)
  Purpose: validate the /cmd_vel -> /odom/TF loop, and later Nav2 mapping/localization/obstacle avoidance.
-->
<sdf version="1.6">
  <world name="omninav_warehouse">

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ========== Perimeter walls: 8 m long in x, 6 m wide in y, 1.2 m high ========== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.0 0.10 1.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.10 1.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.0 0.10 1.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.0 0.10 1.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4.0 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.10 6.0 1.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.10 6.0 1.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4.0 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.10 6.0 1.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.10 6.0 1.2</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ========== Shelves: long benches along two walls, simulating warehouse storage slots ========== -->
    <model name="shelf_a">
      <static>true</static>
      <pose>-1.5 2.45 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.50 0.90</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.50 0.90</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>

    <model name="shelf_b">
      <static>true</static>
      <pose>2.6 -2.45 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.50 0.90</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.50 0.90</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/WoodPallet</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ========== Loose boxes (for navigation obstacle avoidance) ========== -->
    <model name="box_1">
      <static>true</static>
      <pose>1.2 1.0 0.20 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.40 0.40 0.40</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.40 0.40 0.40</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>-2.2 -1.1 0.15 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.30 0.30 0.30</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.30 0.30 0.30</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Simulation time / physics parameters -->
    <gui>
      <camera name="user_camera">
        <pose>-3.5 -3.5 2.6 0 0.35 0.75</pose>
      </camera>
    </gui>

  </world>
</sdf>
